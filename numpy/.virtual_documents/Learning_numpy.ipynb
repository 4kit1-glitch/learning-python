def fill_num(n):
    if num % 2 == 0:
        return 255
    else:
        return 0


chess = np.full((8, 8), 255)


for i in range(len(chess)):
    for j in range(len(chess)):
        if i % 2 == 0 and j % 2 == 0:
            chess[i][j] = 0
        elif j % 2 == 0:
            chess[i][j] = 255
        else:
            chess[i][j] = 0
print(chess)


import matplotlib.pyplot as plt
plt.imshow(chess, cmap = "gray", vmin = 0, vmax = 255)
plt.axis("off")
plt.show()






