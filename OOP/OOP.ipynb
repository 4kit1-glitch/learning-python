   ],
   "source": [
    "class student:\n",
    "    def __init__(self, name, age):\n",
    "        self.name = name\n",
    "        self.age = age\n",
    "\n",
    "    def greet(self):\n",
    "        greetings = f\"hello my name is {self.name}\"\n",
    "        return greetings, self"
   ]
  },
